 <sys:String x:Key="ErrorTweetNotFound">未找到该推文。</sys:String>
 <sys:String x:Key="ErrorUnavailable">该推文当前不可用。</sys:String>
 <sys:String x:Key="ErrorNetwork">无法连接 X，请检查网络后重试。</sys:String>
 <sys:String x:Key="ErrorUnexpected">出现意外错误，请稍后重试。🍌</sys:String>
