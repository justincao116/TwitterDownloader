<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <sys:String x:Key="AppTitle">X / Twitter 媒体下载器</sys:String>
 <sys:String x:Key="AppSubtitle">粘贴推文链接，查找并保存其中的视频、GIF 或图片。</sys:String>
 <sys:String x:Key="Settings">设置</sys:String>
 <sys:String x:Key="PastePlaceholder">粘贴 x.com 或 twitter.com 推文链接...</sys:String>
