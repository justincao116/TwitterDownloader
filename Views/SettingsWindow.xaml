<Window x:Class="X.Desktop.Views.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:infra="clr-namespace:X.Desktop.Infrastructure"
 Title="{DynamicResource SettingsTitle}" Width="560" Height="520" MinWidth="500" MinHeight="460"
 ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock FontSize="24" FontWeight="Bold" Text="{DynamicResource SettingsTitle}"/>
  <StackPanel Grid.Row="1" Margin="0,24,0,0">
   <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="{DynamicResource Language}"/>
   <ComboBox Width="210" HorizontalAlignment="Left" ItemsSource="{Binding LanguageOptions}"
    SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName"/>
  </StackPanel>
  <Border Grid.Row="2" Margin="0,24,0,20" Padding="18" Background="White"
   BorderBrush="#DDE2EA" BorderThickness="1" CornerRadius="11">
   <StackPanel>
    <TextBlock FontSize="17" FontWeight="SemiBold" Text="{DynamicResource CookieSection}"/>
    <TextBlock Margin="0,5,0,0" Foreground="#667184" Text="{DynamicResource CookieDescription}" TextWrapping="Wrap"/>
    <TextBlock Margin="0,14,0,0" Foreground="#248A61" Text="{DynamicResource CookieConfigured}"
     Visibility="{Binding IsCookieConfigured, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    <TextBlock Margin="0,14,0,0" Foreground="#7B8493" Text="{DynamicResource CookieNotConfigured}"
     Visibility="{Binding IsCookieConfigured, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
    <Border Margin="0,14,0,0" Padding="10,8" Background="#F7F8FA" BorderBrush="#CDD3DD"
     BorderThickness="1" CornerRadius="7">
     <Grid>
      <TextBlock VerticalAlignment="Center" Foreground="#8A94A3" IsHitTestVisible="False"
       Text="{DynamicResource CookiePlaceholder}"
       Visibility="{Binding HasCookieInput, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
      <PasswordBox Background="Transparent" BorderThickness="0"
       infra:PasswordBoxBinding.BindPassword="True"
       infra:PasswordBoxBinding.BoundPassword="{Binding CookieInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
     </Grid>
    </Border>
    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
     <Button Margin="0,0,8,0" Command="{Binding ClearCookieCommand}" Style="{StaticResource GhostButtonStyle}"
      Content="{DynamicResource ClearCookie}"/>
     <Button Command="{Binding SaveCookieCommand}" Style="{StaticResource PrimaryButtonStyle}"
      Content="{DynamicResource SaveCookie}"/>
    </StackPanel>
    <TextBlock Margin="0,13,0,0" Foreground="#667184" FontSize="12"
     Text="{DynamicResource CookieSecurityNote}" TextWrapping="Wrap"/>
    <TextBlock Margin="0,8,0,0" Foreground="#A1262E" Text="{Binding StatusMessage}" TextWrapping="Wrap"
     Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
   </StackPanel>
  </Border>
  <Button Grid.Row="3" MinWidth="88" HorizontalAlignment="Right" IsCancel="True"
   Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Close}"/>
 </Grid>
</Window>