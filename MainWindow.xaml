<Window x:Class="X.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource AppTitle}" Width="820" Height="760" MinWidth="640" MinHeight="520"
 WindowStartupLocation="CenterScreen">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <Grid MaxWidth="680" Margin="34,38,34,48">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="2,0,2,22">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock FontSize="27" FontWeight="Bold" Text="{DynamicResource AppTitle}"/>
     <TextBlock Margin="0,5,0,0" Foreground="#667184" FontSize="14" Text="{DynamicResource AppSubtitle}"/>
    </StackPanel>
    <Button Grid.Column="1" Command="{Binding OpenSettingsCommand}" Style="{StaticResource GhostButtonStyle}"
     ToolTip="{DynamicResource Settings}">
     <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" FontSize="17" Text="⚙"/>
      <TextBlock Text="{DynamicResource Settings}"/></StackPanel>
    </Button>
   </Grid>

   <Border Grid.Row="1" Padding="16" Background="{StaticResource CardBrush}" CornerRadius="13">
    <Border Padding="7,6" Background="White" BorderBrush="#D7DCE5" BorderThickness="1" CornerRadius="9">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Command="{Binding ClearCommand}" Style="{StaticResource GhostButtonStyle}">
       <TextBlock FontSize="17"><TextBlock.Style><Style TargetType="TextBlock">
        <Setter Property="Text" Value="😎"/><Style.Triggers>
         <DataTrigger Binding="{Binding HasTweetUrl}" Value="True"><Setter Property="Text" Value="😵"/></DataTrigger>
        </Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Button>
      <Grid Grid.Column="1" Margin="5,0,8,0">
       <TextBlock VerticalAlignment="Center" Foreground="#8A94A3" IsHitTestVisible="False"
        Text="{DynamicResource PastePlaceholder}"
        Visibility="{Binding HasTweetUrl, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
       <TextBox VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="14"
        Text="{Binding TweetUrl, UpdateSourceTrigger=PropertyChanged}"/>
      </Grid>
      <Button Grid.Column="2" Command="{Binding SearchCommand}" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}">
       <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,6,0" Text="🔍"/>
        <TextBlock><TextBlock.Style><Style TargetType="TextBlock">
         <Setter Property="Text" Value="{DynamicResource Search}"/><Style.Triggers>
          <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="{DynamicResource Searching}"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel>
      </Button>
     </Grid>
    </Border>
   </Border>

   <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,11" Background="{StaticResource DangerBrush}"
    BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="9"
    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
    <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,10,0" FontSize="18" Text="ⓧ"/>
     <TextBlock VerticalAlignment="Center" Foreground="{StaticResource DangerTextBrush}"
      Text="{Binding ErrorMessage}" TextWrapping="Wrap"/></StackPanel>
   </Border>

   <ItemsControl Grid.Row="3" Margin="0,16,0,0" ItemsSource="{Binding MediaItems}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Margin="0,0,0,16" Padding="16" Background="{StaticResource CardBrush}" CornerRadius="13">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="164" Height="112" HorizontalAlignment="Left" VerticalAlignment="Top"
        Background="#151A21" CornerRadius="8" ClipToBounds="True">
        <Image Source="{Binding PreviewUrl, IsAsync=True}" Stretch="UniformToFill"/>
       </Border>
       <Grid Grid.Column="1" Margin="18,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Foreground="{StaticResource CardTextBrush}" FontSize="17" FontWeight="SemiBold" Text="{Binding Title}"/>
        <StackPanel Grid.Row="1" Margin="0,13,0,0">
         <TextBlock Margin="1,0,0,5" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="{DynamicResource Quality}"/>
         <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="DisplayName"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
         <Button Margin="0,0,8,0" Command="{Binding OpenCommand}" Foreground="{StaticResource CardTextBrush}"
          Style="{StaticResource GhostButtonStyle}">
          <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,5,0" Text="↗"/>
           <TextBlock Text="{DynamicResource OpenBrowser}"/></StackPanel>
         </Button>
         <Button Command="{Binding DownloadCommand}" Style="{StaticResource SecondaryButtonStyle}">
          <StackPanel Orientation="Horizontal"><TextBlock Margin="0,0,5,0" Text="🚀"/>
           <TextBlock Text="{DynamicResource Download}"/></StackPanel>
         </Button>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,11,0,0">
         <ProgressBar Height="5" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}"
          Value="{Binding DownloadPercentage, Mode=OneWay}"
          Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
         <TextBlock Margin="1,6,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
          Text="{Binding StatusMessage}" TextWrapping="Wrap"
          Visibility="{Binding HasStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
       </Grid>
      </Grid>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </Grid>
 </ScrollViewer>
</Window>